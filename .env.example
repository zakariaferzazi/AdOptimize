DISABLE_HMR=
FIREBASE_API_KEY=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
MODEL_CHATGPT=
MODEL_DEEPSEEK=
MODEL_GEMINI=
NEXT_PUBLIC_GOOGLE_ADS_CLIENT_ID=
OPENROUTER_API_KEY=

# AI agent storage. Leave unset in production to use the D1 binding named DB.
# Set to "memory" for local development without a D1 database.
AI_STORE=
# Minutes before an unapproved proposal expires. Defaults to 60.
AI_PROPOSAL_EXPIRATION_MINUTES=
# Development only: allow unauthenticated AI routes. Ignored in production.
# This never bypasses authentication or subscription checks on Pro routes.
AI_ALLOW_ANONYMOUS=

# Server-only Polar billing. POLAR_ENVIRONMENT (sandbox|production, default sandbox)
# selects the whole credential set: API server, token, organization, products and
# webhook secret. Production uses the plain names; sandbox uses the _SANDBOX names.
# The two sets are never mixed or used as fallbacks for each other.
APP_URL=http://localhost:3000
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN_SANDBOX=
POLAR_WEBHOOK_SECRET_SANDBOX=
POLAR_ORGANIZATION_ID_SANDBOX=
POLAR_PRODUCT_PRO_MONTHLY_SANDBOX=
POLAR_PRODUCT_PRO_YEARLY_SANDBOX=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=

# 32 random bytes, base64 (for example: openssl rand -base64 32). Encrypts stored
# Google Ads refresh tokens (AES-256-GCM). Server-only; losing it requires reconnecting.
TOKEN_ENCRYPTION_KEY=