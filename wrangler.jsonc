{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adoptimize",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // D1 binding for durable AI conversation, proposal and execution storage.
  //
  // A D1 database must exist before it can be bound. Create it once:
  //   npx wrangler d1 create adoptimize-ai
  // then paste the returned database_id below and redeploy.
  //
  // Until the binding is present the AI agent falls back to an in-memory store,
  // which is NOT durable across requests. The server logs a loud warning when
  // that happens in production.
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "adoptimize-ai",
  //     "database_id": "<paste the id from `wrangler d1 create`>",
  //     "migrations_dir": "migrations"
  //   }
  // ],
  "observability": {
    "enabled": true
  }
}
