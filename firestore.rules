rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Health check and connection test
    match /test/connection {
      allow read: if true;
    }

    // User profile document and all user-owned subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Connected Google Ads accounts
      match /accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }

      // Live Google Ads campaigns
      match /campaigns/{campaignId} {
        allow read, write: if isOwner(userId);
      }

      // Anomaly alerts
      match /anomalies/{anomalyId} {
        allow read, write: if isOwner(userId);
      }

      // AI insights & root-cause diagnostics
      match /insights/{insightId} {
        allow read, write: if isOwner(userId);
      }

      // Budget recommendations & reallocations
      match /budgetRecommendations/{recId} {
        allow read, write: if isOwner(userId);
      }

      // Automation rules
      match /automationRules/{ruleId} {
        allow read, write: if isOwner(userId);
      }

      // Immutable change audit logs
      match /auditLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Campaign keywords
      match /keywords/{keywordId} {
        allow read, write: if isOwner(userId);
      }

      // Search terms query reports
      match /searchTerms/{termId} {
        allow read, write: if isOwner(userId);
      }

      // Fallback for any other user-specific subcollections
      match /{allChildren=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
